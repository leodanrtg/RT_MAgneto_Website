# Copia este archivo como .env y rellénalo. Nunca subas .env al repositorio.

NODE_ENV=production
APP_URL=https://tudominio.com            # URL pública de la web (https obligatorio en producción)
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true                         # true detrás de Caddy/Nginx
DATABASE_URL=postgres://rt:CAMBIAR@db:5432/rt_comercial

# 32 bytes aleatorios en base64: openssl rand -base64 32
# Cifra las claves de licencia guardadas. Si se pierde, no se pueden volver a mostrar.
DATA_ENCRYPTION_KEY=

SESSION_TTL_DAYS=14
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# PayPal: empieza con sandbox. Credenciales en developer.paypal.com > Apps & Credentials.
PAYPAL_ENV=sandbox                       # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                       # ID del webhook registrado apuntando a APP_URL/api/webhooks/paypal

# Reembolso total del último pago: suspend (suspende el acceso) | keep (lo mantiene)
REFUND_POLICY=suspend

# Correo transaccional: postmark | resend (console solo en desarrollo)
# brevo | postmark | resend. Brevo: clave API (no la SMTP) en Brevo > SMTP & API > API Keys
MAIL_PROVIDER=brevo
MAIL_API_KEY=
MAIL_FROM="RT Magneto <licencias@tudominio.com>"
SUPPORT_EMAIL=soporte@tudominio.com

# Sistema de licencias: simulated (solo desarrollo) | bridge (servicio puente en el servidor de licencias)
LICENSE_ENGINE=bridge
LICENSE_BRIDGE_URL=
LICENSE_BRIDGE_SECRET=                   # secreto compartido HMAC: openssl rand -hex 32

# Pon false si ejecutas el proceso de tareas aparte (npm run worker)
RUN_WORKER=true

# Solo para docker-compose.yml
DOMAIN=tudominio.com
POSTGRES_PASSWORD=
