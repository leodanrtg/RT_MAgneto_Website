{$DOMAIN} {
	encode zstd gzip
	# la API y los webhooks van al backend; el resto es la web estática
	handle /api/* {
		reverse_proxy app:3000
	}
	handle {
		root * /srv/web
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
	}
}
